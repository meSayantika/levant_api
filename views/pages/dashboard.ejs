<!-- =============================================
     SYNERGIC PAY - Dashboard Page
     Modern dashboard with stat cards and activity overview
     ============================================= -->

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <div>
        <h1 class="fs-4 fw-bold text-dark mb-1">Dashboard</h1>
        <p class="text-muted small mb-0">
            Welcome back, <strong><%= typeof user !== 'undefined' && user ? user.username : 'Admin' %></strong>! Here's your overview.
        </p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <button class="btn btn-light btn-sm d-flex align-items-center gap-1 rounded-3 shadow-sm" id="refreshDashboard">
            <i class="bi bi-arrow-clockwise"></i>
            <span class="d-none d-sm-inline">Refresh</span>
        </button>
        <button class="btn sp-btn-primary btn-sm d-flex align-items-center gap-1 rounded-3 shadow-sm" id="generateQRBtn">
            <i class="bi bi-plus-lg"></i>
            <span>New QR Code</span>
        </button>
    </div>
</div>

<!-- ---- Stat Cards Row ---- -->
<div class="row g-4 mb-4">
    <!-- Total Users -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="sp-stat-card card border-0 rounded-4 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="sp-stat-icon sp-stat-icon-purple d-flex align-items-center justify-content-center rounded-3">
                        <i class="bi bi-people-fill fs-5"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success rounded-pill small fw-medium">
                        <i class="bi bi-arrow-up-short"></i> 12%
                    </span>
                </div>
                <h3 class="fw-bold text-dark mb-1" id="metricTotalUsers">
                    <%= typeof metrics !== 'undefined' ? metrics.totalUsers.toLocaleString() : '0' %>
                </h3>
                <p class="text-muted small mb-0">Total Users</p>
                <div class="progress mt-3" style="height: 4px;">
                    <div class="progress-bar sp-progress-purple rounded-pill" style="width: 72%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Transactions -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="sp-stat-card card border-0 rounded-4 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="sp-stat-icon sp-stat-icon-blue d-flex align-items-center justify-content-center rounded-3">
                        <i class="bi bi-arrow-left-right fs-5"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success rounded-pill small fw-medium">
                        <i class="bi bi-arrow-up-short"></i> 8%
                    </span>
                </div>
                <h3 class="fw-bold text-dark mb-1" id="metricTotalTxns">
                    <%= typeof metrics !== 'undefined' ? metrics.totalTransactions.toLocaleString() : '0' %>
                </h3>
                <p class="text-muted small mb-0">Total Transactions</p>
                <div class="progress mt-3" style="height: 4px;">
                    <div class="progress-bar sp-progress-blue rounded-pill" style="width: 58%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Revenue -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="sp-stat-card card border-0 rounded-4 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="sp-stat-icon sp-stat-icon-green d-flex align-items-center justify-content-center rounded-3">
                        <i class="bi bi-currency-rupee fs-5"></i>
                    </div>
                    <span class="badge bg-warning-subtle text-warning rounded-pill small fw-medium">
                        <i class="bi bi-dash"></i> 2%
                    </span>
                </div>
                <h3 class="fw-bold text-dark mb-1" id="metricRevenue">
                    ₹<%= typeof metrics !== 'undefined' ? Number(metrics.totalRevenue).toLocaleString('en-IN') : '0' %>
                </h3>
                <p class="text-muted small mb-0">Total Revenue</p>
                <div class="progress mt-3" style="height: 4px;">
                    <div class="progress-bar sp-progress-green rounded-pill" style="width: 45%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Active QR Codes -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="sp-stat-card card border-0 rounded-4 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div class="sp-stat-icon sp-stat-icon-orange d-flex align-items-center justify-content-center rounded-3">
                        <i class="bi bi-qr-code fs-5"></i>
                    </div>
                    <span class="badge bg-success-subtle text-success rounded-pill small fw-medium">
                        <i class="bi bi-arrow-up-short"></i> 24%
                    </span>
                </div>
                <h3 class="fw-bold text-dark mb-1" id="metricActiveQR">
                    <%= typeof metrics !== 'undefined' ? metrics.activeQRCodes.toLocaleString() : '0' %>
                </h3>
                <p class="text-muted small mb-0">Active QR Codes</p>
                <div class="progress mt-3" style="height: 4px;">
                    <div class="progress-bar sp-progress-orange rounded-pill" style="width: 85%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ---- Second Row: Recent Activity & Quick Actions ---- -->
<div class="row g-4">
    <!-- Recent Transactions Table -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 rounded-4 shadow-sm">
            <div class="card-header bg-white border-0 rounded-top-4 px-4 pt-4 pb-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Recent Transactions</h6>
                        <small class="text-muted">Latest payment activities</small>
                    </div>
                    <a href="#" class="btn btn-light btn-sm rounded-3">
                        View All <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>
            </div>
            <div class="card-body px-4 pb-4">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" id="recentTxnTable">
                        <thead>
                            <tr class="text-muted small">
                                <th class="border-0 fw-semibold">Transaction ID</th>
                                <th class="border-0 fw-semibold">Merchant</th>
                                <th class="border-0 fw-semibold">Amount</th>
                                <th class="border-0 fw-semibold">Status</th>
                                <th class="border-0 fw-semibold">Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="fw-medium">#TXN-0042</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="sp-merchant-avatar rounded-circle d-flex align-items-center justify-content-center">
                                            <small class="fw-bold">AS</small>
                                        </div>
                                        <span>Alpha Store</span>
                                    </div>
                                </td>
                                <td class="fw-semibold">₹2,500</td>
                                <td><span class="badge bg-success-subtle text-success rounded-pill px-3">Success</span></td>
                                <td class="text-muted small">Today, 2:30 PM</td>
                            </tr>
                            <tr>
                                <td class="fw-medium">#TXN-0041</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="sp-merchant-avatar rounded-circle d-flex align-items-center justify-content-center">
                                            <small class="fw-bold">BM</small>
                                        </div>
                                        <span>Beta Market</span>
                                    </div>
                                </td>
                                <td class="fw-semibold">₹1,200</td>
                                <td><span class="badge bg-warning-subtle text-warning rounded-pill px-3">Pending</span></td>
                                <td class="text-muted small">Today, 1:15 PM</td>
                            </tr>
                            <tr>
                                <td class="fw-medium">#TXN-0040</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="sp-merchant-avatar rounded-circle d-flex align-items-center justify-content-center">
                                            <small class="fw-bold">GF</small>
                                        </div>
                                        <span>Gamma Foods</span>
                                    </div>
                                </td>
                                <td class="fw-semibold">₹850</td>
                                <td><span class="badge bg-success-subtle text-success rounded-pill px-3">Success</span></td>
                                <td class="text-muted small">Yesterday</td>
                            </tr>
                            <tr>
                                <td class="fw-medium">#TXN-0039</td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="sp-merchant-avatar rounded-circle d-flex align-items-center justify-content-center">
                                            <small class="fw-bold">DS</small>
                                        </div>
                                        <span>Delta Services</span>
                                    </div>
                                </td>
                                <td class="fw-semibold">₹5,000</td>
                                <td><span class="badge bg-danger-subtle text-danger rounded-pill px-3">Failed</span></td>
                                <td class="text-muted small">Yesterday</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions & Activity Feed -->
    <div class="col-12 col-lg-4">
        <!-- Quick Actions -->
        <div class="card border-0 rounded-4 shadow-sm mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold text-dark mb-3">Quick Actions</h6>
                <div class="d-grid gap-2">
                    <button class="btn btn-light d-flex align-items-center gap-3 py-3 px-3 rounded-3 text-start sp-quick-action" id="quickActionQR">
                        <div class="sp-qa-icon sp-qa-purple d-flex align-items-center justify-content-center rounded-3">
                            <i class="bi bi-qr-code text-white"></i>
                        </div>
                        <div>
                            <span class="fw-semibold d-block small">Generate QR</span>
                            <small class="text-muted">Create a new payment QR</small>
                        </div>
                    </button>
                    <button class="btn btn-light d-flex align-items-center gap-3 py-3 px-3 rounded-3 text-start sp-quick-action" id="quickActionUser">
                        <div class="sp-qa-icon sp-qa-blue d-flex align-items-center justify-content-center rounded-3">
                            <i class="bi bi-person-plus-fill text-white"></i>
                        </div>
                        <div>
                            <span class="fw-semibold d-block small">Add User</span>
                            <small class="text-muted">Register a new user</small>
                        </div>
                    </button>
                    <button class="btn btn-light d-flex align-items-center gap-3 py-3 px-3 rounded-3 text-start sp-quick-action" id="quickActionReport">
                        <div class="sp-qa-icon sp-qa-green d-flex align-items-center justify-content-center rounded-3">
                            <i class="bi bi-file-earmark-bar-graph text-white"></i>
                        </div>
                        <div>
                            <span class="fw-semibold d-block small">View Reports</span>
                            <small class="text-muted">Download analytics</small>
                        </div>
                    </button>
                </div>
            </div>
        </div>

        <!-- Activity Feed -->
        <div class="card border-0 rounded-4 shadow-sm">
            <div class="card-body p-4">
                <h6 class="fw-bold text-dark mb-3">Activity Feed</h6>
                <div class="sp-activity-feed">
                    <div class="sp-activity-item d-flex gap-3 mb-3">
                        <div class="sp-activity-dot bg-success rounded-circle mt-2" style="width:8px; height:8px; min-width:8px;"></div>
                        <div>
                            <p class="small mb-0 fw-medium">New merchant onboarded</p>
                            <small class="text-muted">Alpha Store — 10 mins ago</small>
                        </div>
                    </div>
                    <div class="sp-activity-item d-flex gap-3 mb-3">
                        <div class="sp-activity-dot bg-primary rounded-circle mt-2" style="width:8px; height:8px; min-width:8px;"></div>
                        <div>
                            <p class="small mb-0 fw-medium">QR code batch generated</p>
                            <small class="text-muted">50 codes — 1 hour ago</small>
                        </div>
                    </div>
                    <div class="sp-activity-item d-flex gap-3 mb-3">
                        <div class="sp-activity-dot bg-warning rounded-circle mt-2" style="width:8px; height:8px; min-width:8px;"></div>
                        <div>
                            <p class="small mb-0 fw-medium">Settlement processed</p>
                            <small class="text-muted">₹1,25,000 — 3 hours ago</small>
                        </div>
                    </div>
                    <div class="sp-activity-item d-flex gap-3">
                        <div class="sp-activity-dot bg-info rounded-circle mt-2" style="width:8px; height:8px; min-width:8px;"></div>
                        <div>
                            <p class="small mb-0 fw-medium">System update completed</p>
                            <small class="text-muted">v1.0.0 — Yesterday</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
