<!-- =============================================
     SYNERGIC PAY - Dashboard Page
     Modern dashboard with stat cards and activity overview
     ============================================= -->

<!-- Page Header -->
<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <div>
        <h1 class="fs-4 fw-bold text-dark mb-1">Dashboard</h1>
        <p class="text-muted small mb-0">
            Welcome back, <strong>
                <%= typeof user !=='undefined' && user ? user.username : 'Admin' %>
            </strong>! Here's your overview.
        </p>
    </div>
    <div class="d-flex gap-2 mt-3 mt-md-0">
        <button class="btn btn-light btn-sm d-flex align-items-center gap-1 rounded-3 shadow-sm" id="refreshDashboard">
            <i class="bi bi-arrow-clockwise"></i>
            <span class="d-none d-sm-inline">Refresh</span>
        </button>
        <button class="btn sp-btn-primary btn-sm d-flex align-items-center gap-1 rounded-3 shadow-sm"
            id="generateQRBtn">
            <i class="bi bi-plus-lg"></i>
            <span>New QR Code</span>
        </button>
    </div>
</div>

<!-- ---- Stat Cards Row ---- -->
<div class="row g-4 mb-4">
    <!-- Total Users -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="sp-stat-card card border-0 rounded-4 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div
                        class="sp-stat-icon sp-stat-icon-purple d-flex align-items-center justify-content-center rounded-3">
                        <i class="bi bi-people-fill fs-5"></i>
                    </div>
                    <span class="badge rounded-pill small fw-medium" style="background-color: rgba(0, 128, 128, 0.15); color: #008080;">
                        <i class="bi bi-arrow-up-short"></i> 12%
                    </span>
                </div>
                <h3 class="fw-bold text-dark mb-1" id="metricTotalUsers">
                    <%= typeof metrics !=='undefined' ? metrics.totalSubMerchants.toLocaleString() : '0' %>
                </h3>
                <p class="text-muted small mb-0">Total Submerchants</p>
                <div class="progress mt-3" style="height: 4px;">
                    <div class="progress-bar sp-progress-purple rounded-pill" style="width: 72%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Transactions -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="sp-stat-card card border-0 rounded-4 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div
                        class="sp-stat-icon sp-stat-icon-blue d-flex align-items-center justify-content-center rounded-3">
                        <i class="bi bi-arrow-left-right fs-5"></i>
                    </div>
                    <span class="badge rounded-pill small fw-medium" style="background-color: rgba(0, 128, 128, 0.15); color: #008080;">
                        <i class="bi bi-arrow-up-short"></i> 8%
                    </span>
                </div>
                <h3 class="fw-bold text-dark mb-1" id="metricTotalTxns">
                    <%= typeof metrics !=='undefined' ? metrics.totalTransactions.toLocaleString() : '0' %>
                </h3>
                <p class="text-muted small mb-0">Total Transactions</p>
                <div class="progress mt-3" style="height: 4px;">
                    <div class="progress-bar sp-progress-blue rounded-pill" style="width: 58%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Revenue -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="sp-stat-card card border-0 rounded-4 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div
                        class="sp-stat-icon sp-stat-icon-green d-flex align-items-center justify-content-center rounded-3">
                        <i class="bi bi-currency-rupee fs-5"></i>
                    </div>
                    <span class="badge rounded-pill small fw-medium" style="background-color: rgba(0, 128, 128, 0.15); color: #008080;">
                        <i class="bi bi-dash"></i> 2%
                    </span>
                </div>
                <h3 class="fw-bold text-dark mb-1" id="metricRevenue">
                    ₹<%= typeof metrics !=='undefined' ? Number(metrics.totalRevenue).toLocaleString('en-IN') : '0' %>
                </h3>
                <p class="text-muted small mb-0">Total Revenue</p>
                <div class="progress mt-3" style="height: 4px;">
                    <div class="progress-bar sp-progress-green rounded-pill" style="width: 45%"></div>
                </div>
            </div>
        </div>
    </div>

    <!-- Active QR Codes -->
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="sp-stat-card card border-0 rounded-4 shadow-sm h-100">
            <div class="card-body p-4">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <div
                        class="sp-stat-icon sp-stat-icon-orange d-flex align-items-center justify-content-center rounded-3">
                        <i class="bi bi-qr-code fs-5"></i>
                    </div>
                    <span class="badge rounded-pill small fw-medium" style="background-color: rgba(0, 128, 128, 0.15); color: #008080;">
                        <i class="bi bi-arrow-up-short"></i> 24%
                    </span>
                </div>
                <h3 class="fw-bold text-dark mb-1" id="metricActiveQR">
                    <%= typeof metrics !=='undefined' ? metrics.activeQRCodes.toLocaleString() : '0' %>
                </h3>
                <p class="text-muted small mb-0">Active QR Codes</p>
                <div class="progress mt-3" style="height: 4px;">
                    <div class="progress-bar sp-progress-orange rounded-pill" style="width: 85%"></div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- ---- Second Row: Activity Graph & Quick Actions ---- -->
<div class="row g-4">
    <!-- Graph -->
    <div class="col-12 col-lg-8">
        <div class="card border-0 rounded-4 shadow-sm h-100">
            <div class="card-header bg-white border-0 rounded-top-4 px-4 pt-4 pb-0">
                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Submerchants Onboarding Trend</h6>
                        <small class="text-muted">Last 7 Days</small>
                    </div>
                </div>
            </div>
            <div class="card-body px-4 pb-4 d-flex justify-content-center">
                <div style="width: 100%; max-width: 700px;">
                    <canvas id="submerchantChart" style="min-height: 150px; max-height: 300px; width: 100%;"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Actions & Activity Feed -->
    <div class="col-12 col-lg-4">
        <!-- Quick Actions -->
        <div class="card border-0 rounded-4 shadow-sm mb-4">
            <div class="card-body p-4">
                <h6 class="fw-bold text-dark mb-3">Quick Actions</h6>
                <div class="d-grid gap-2">
                    <a href="/admin/merchants/create"
                        class="btn btn-light d-flex align-items-center gap-3 py-3 px-3 rounded-3 text-start sp-quick-action"
                        style="text-decoration: none; color: inherit;">
                        <div class="sp-qa-icon sp-qa-purple d-flex align-items-center justify-content-center rounded-3">
                            <i class="bi bi-person-plus-fill text-white"></i>
                        </div>
                        <div>
                            <span class="fw-semibold d-block small">Onboard Submerchant</span>
                            <small class="text-muted">Register a new submerchant</small>
                        </div>
                    </a>
                    <a href="/admin/kyc/generate_kyc"
                        class="btn btn-light d-flex align-items-center gap-3 py-3 px-3 rounded-3 text-start sp-quick-action"
                        style="text-decoration: none; color: inherit;">
                        <div class="sp-qa-icon sp-qa-orange d-flex align-items-center justify-content-center rounded-3">
                            <i class="bi bi-shield-check text-white"></i>
                        </div>
                        <div>
                            <span class="fw-semibold d-block small">Generate KYC</span>
                            <small class="text-muted">Generate submerchant KYC link</small>
                        </div>
                    </a>
                    <button
                        class="btn btn-light d-flex align-items-center gap-3 py-3 px-3 rounded-3 text-start sp-quick-action"
                        id="quickActionQR">
                        <div class="sp-qa-icon sp-qa-blue d-flex align-items-center justify-content-center rounded-3">
                            <i class="bi bi-qr-code text-white"></i>
                        </div>
                        <div>
                            <span class="fw-semibold d-block small">Generate QR</span>
                            <small class="text-muted">Create a new payment QR</small>
                        </div>
                    </button>
                    <button
                        class="btn btn-light d-flex align-items-center gap-3 py-3 px-3 rounded-3 text-start sp-quick-action"
                        id="quickActionReport">
                        <div class="sp-qa-icon sp-qa-green d-flex align-items-center justify-content-center rounded-3">
                            <i class="bi bi-file-earmark-bar-graph text-white"></i>
                        </div>
                        <div>
                            <span class="fw-semibold d-block small">View Reports</span>
                            <small class="text-muted">Download analytics</small>
                        </div>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        // Parse chart data passed from the controller
        const rawChartData = '<%- JSON.stringify(metrics.chartData || {labels:[], data:[]}) %>';
        const chartData = JSON.parse(rawChartData);

        const ctx = document.getElementById('submerchantChart');
        if (ctx) {
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: chartData.labels,
                    datasets: [{
                        label: 'New Submerchants',
                        data: chartData.data,
                        backgroundColor: 'rgba(0, 128, 128, 0.8)',
                        borderColor: 'rgba(0, 128, 128, 1)',
                        borderWidth: 1,
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            ticks: { precision: 0 }
                        }
                    },
                    plugins: {
                        legend: { display: false }
                    }
                }
            });
        }
    });
</script>