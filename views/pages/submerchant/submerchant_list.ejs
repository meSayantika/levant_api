<style>
    :root {
        --sm-primary: #008080;
        --sm-secondary: #32a995;
        --sm-surface: #ffffff;
        --sm-bg: #f8f9fc;
        --sm-text: #1a1a2e;
        --sm-muted: #6c757d;
        --sm-border: #e8e8f0;
    }

    body {
        background-color: var(--sm-bg);
    }

    .sm-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1.6rem;
        flex-wrap: wrap;
        gap: 1rem;
    }

    .sm-header-left {
        display: flex;
        align-items: center;
        gap: 0.85rem;
        flex-wrap: wrap;
    }

    .sm-page-icon {
        width: 44px;
        height: 44px;
        background: linear-gradient(135deg, var(--sm-primary), var(--sm-secondary));
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        box-shadow: 0 4px 14px rgba(0, 128, 128, 0.3);
    }

    .sm-page-title h4 {
        margin: 0;
        font-weight: 700;
        color: var(--sm-text);
        letter-spacing: -0.3px;
    }

    .sm-page-title p {
        margin: 0;
        font-size: 0.85rem;
        color: var(--sm-muted);
    }

    .sm-card {
        background: #ffffff;
        border: 1px solid #e8e8f0;
        border-left: 5px solid #008080;
        /* THICK LEFT BORDER */
        border-radius: 12px;
        box-shadow: 0 2px 16px rgba(102, 126, 234, 0.07);
        padding: 1.2rem;
        margin-bottom: 2rem;
        max-width: 100%;
    }

    /* ===== TABLE STYLING MATCHING GENERATE KYC ===== */
    .sm-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.875rem;
    }

    .sm-table thead tr,
    .sm-table thead th {
        background: #008080 !important;
        color: #ffffff !important;
        font-weight: 600;
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.05em;
        padding: 1rem 1.15rem;
        border: none;
        white-space: nowrap;
    }

    .sm-table tbody tr {
        border-bottom: 1px solid #f1f2f8;
        transition: background 0.15s;
    }

    .sm-table tbody tr:hover {
        background: rgba(0, 128, 128, 0.05);
    }

    .sm-table tbody td {
        padding: 0.88rem 1.15rem;
        color: #2d3748;
        vertical-align: middle;
    }

    .btn-onboard {
        background: linear-gradient(135deg, #008080, #32a995);
        color: white;
        border: none;
        padding: 0.6rem 1.3rem;
        border-radius: 8px;
        font-weight: 600;
        transition: all 0.3s ease;
        /* margin-right: 1vw; */
    }

    .btn-onboard:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 12px rgba(0, 128, 128, 0.4);
        color: white;
    }

    .sm-results-header {
        padding: 0.8rem 1.2rem;
        background: rgba(0, 128, 128, 0.08);
        border-bottom: 1px solid #e8e8f0;
        display: flex;
        align-items: center;
        gap: 0.55rem;
        margin: -1.2rem -1.2rem 1.2rem -1.2rem;
        /* pull to edges of padding */
        border-top-right-radius: 12px;
    }

    .sm-results-header .results-title {
        font-size: 0.88rem;
        font-weight: 700;
        color: #1a1a2e;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .sm-count-badge {
        background: linear-gradient(135deg, #008080, #32a995);
        color: #fff;
        font-size: 0.7rem;
        font-weight: 700;
        border-radius: 20px;
        padding: 0.15rem 0.65rem;
        line-height: 1.4;
    }

    .sm-pagination {
        display: flex;
        justify-content: flex-end;
        margin-top: 1rem;
    }

    .sm-pagination .page-item.active .page-link {
        background-color: var(--sm-primary);
        border-color: var(--sm-primary);
        color: white;
    }

    .sm-pagination .page-link {
        color: var(--sm-primary);
    }
</style>

<div class="container py-4">
    <!-- Header -->
    <div class="sm-page-header">
        <div class="sm-header-left">
            <div class="sm-page-icon">
                <i class="bi bi-shop"></i>
            </div>
            <div class="sm-page-title">
                <h4>Sub Merchants</h4>
                <p>Manage and view all onboarded sub-merchants</p>
            </div>
        </div>
        <div class="sm-header-right">
            <a href="/admin/merchants/create" class="btn btn-onboard">
                <i class="bi bi-plus-circle me-1"></i> Onboard Submerchant
            </a>
        </div>
    </div>

    <!-- Table Card -->
    <div class="sm-card">
        <div class="sm-results-header">
            <i class="bi bi-card-list fs-5" style="color: var(--sm-primary);"></i>
            <span class="results-title">Onboarded Merchants List</span>
            <span class="sm-count-badge ms-auto">
                <%= typeof totalRecords !== 'undefined' ? totalRecords : (merchants ? merchants.length : 0) %> Records
            </span>
        </div>
        <div class="table-responsive">
            <table id="submerchantTable" class="table sm-table align-middle w-100">
                <thead>
                    <tr>
                        <th>Submerchant Code</th>
                        <th>Submerchant Name</th>
                        <th>Email</th>
                        <th>Phone</th>
                        <!-- <th>Business Address</th> -->
                        <th>Created At</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (merchants && merchants.length> 0) { %>
                        <% merchants.forEach(merchant=> { %>
                            <tr>
                                <td class="fw-semibold">
                                    <%= merchant.SUB_MERCHANT_CODE || 'N/A' %>
                                        <% if (merchant.SUB_MERCHANT_CODE==='0' || (merchant.SUB_MERCHANT_CODE &&
                                            merchant.SUB_MERCHANT_CODE.toUpperCase().startsWith('F')) ||
                                            (merchant.SUB_MERCHANT_CODE &&
                                            merchant.SUB_MERCHANT_CODE.toLowerCase().startsWith('f')) ) { %>
                                            <br><small class="text-danger fw-bold" style="font-size: 0.75rem;">(Need to
                                                generate Submerchant Code)</small>
                                            <% } %>
                                </td>
                                <td class="fw-semibold">
                                    <%= merchant.LEGAL_NAME || 'N/A' %>
                                </td>
                                <td class="fw-semibold">
                                    <%= merchant.EMAIL || 'N/A' %>
                                </td>
                                <td class="fw-semibold">
                                    <%= merchant.PHONE || 'N/A' %>
                                </td>
                                <!-- <td class="fw-semibold">
                                    <span class="d-inline-block text-truncate" style="max-width: 200px;" title="<%= merchant.BUSINESS_ADDRESS || 'N/A' %>">
                                        <%= merchant.BUSINESS_ADDRESS || 'N/A' %>
                                    </span>
                                </td> -->
                                <td class="fw-semibold">
                                    <%= merchant.CREATED_DATE || 'N/A' %>
                                </td>
                                <td>
                                    <a href="/admin/merchants/view/<%= merchant.ENCRYPTED_CUST_CD %>"
                                        class="btn btn-sm sp-btn-primary" data-bs-toggle="tooltip"
                                        data-bs-placement="top" title="View Submerchant">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                            <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="7" class="text-center py-5">
                                            <div class="d-flex flex-column align-items-center justify-content-center">
                                                <i class="bi bi-inbox fs-1 text-muted mb-3 opacity-50"></i>
                                                <h6 class="text-muted fw-semibold mb-0">No data on onboard submerchant
                                                </h6>
                                            </div>
                                        </td>
                                    </tr>
                                    <% } %>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Server-Side Pagination Component (Outside Card & Right Aligned) -->
    <% if (typeof totalPages !== 'undefined' && totalPages > 0) { %>
        <nav aria-label="Page navigation" class="sm-pagination">
            <ul class="pagination pagination-sm mb-0">
                <!-- Previous Button -->
                <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                    <a class="page-link" href="?page=<%= currentPage - 1 %>" tabindex="-1">Previous</a>
                </li>
                
                <!-- Page Numbers -->
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <% if (i === 1 || i === totalPages || (i >= currentPage - 2 && i <= currentPage + 2)) { %>
                        <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                            <a class="page-link" href="?page=<%= i %>"><%= i %></a>
                        </li>
                    <% } else if (i === currentPage - 3 || i === currentPage + 3) { %>
                        <li class="page-item disabled"><span class="page-link">...</span></li>
                    <% } %>
                <% } %>
                
                <!-- Next Button -->
                <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                    <a class="page-link" href="?page=<%= currentPage + 1 %>">Next</a>
                </li>
            </ul>
        </nav>
    <% } %>
</div>