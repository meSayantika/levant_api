<%#=============================================%>
    <%# SYNERGIC PAY - Sub Merchant Onboarding Page %>
        <%#=============================================%>

            <style>
                /* ===== DESIGN TOKENS (matching sidebar blue) ===== */
                :root {
                    --sm-primary: #008080;
                    --sm-primary-dark: #004d40;
                    --sm-secondary: #32a995;
                    --sm-primary-soft: rgba(0, 128, 128, 0.08);
                    --sm-primary-mid: rgba(0, 128, 128, 0.15);
                    --sm-border: #e8e8f0;
                    --sm-text: #1a1a2e;
                    --sm-muted: #6c757d;
                    --sm-surface: #ffffff;
                    --sm-bg: #f8f9fc;
                }

                /* ===== BLUE BORDER — ALL INPUT & SELECT FIELDS ===== */
                /* #subMerchantForm .material-outline input.form-control,
                #subMerchantForm .material-outline select.form-select {
                    border: 1.5px solid #667eea !important;
                    border-radius: 8px !important;
                } */

                /* #subMerchantForm .material-outline input.form-control:focus,
                #subMerchantForm .material-outline select.form-select:focus {
                    border: 2px solid #5a67d8 !important;
                    box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.15) !important;
                } */

                /* Select2 container border */
                #subMerchantForm .material-outline .select2-container--bootstrap-5 .select2-selection {
                    border: 1px solid var(--sm-border) !important;
                    border-radius: 8px !important;
                    padding-top: 0.8rem;
                    padding-bottom: 0.8rem;
                }

                #subMerchantForm .material-outline .select2-container--bootstrap-5.select2-container--focus .select2-selection,
                #subMerchantForm .material-outline .select2-container--bootstrap-5.select2-container--open .select2-selection {
                    border: 1px solid var(--sm-primary) !important;
                    box-shadow: 0 0 0 4px rgba(0, 128, 128, 0.1) !important;
                }


                /* ===== LABEL COLOR → BLACK (all states) ===== */
                /* #subMerchantForm .material-outline label {
                    color: #1a1a2e !important;
                } */

                /* Focused label → black */
                /* #subMerchantForm .material-outline input.form-control:focus~label,
                #subMerchantForm .material-outline select.form-select:focus~label {
                    color: #1a1a2e !important;
                } */

                /* Filled but not focused → black */
                /* #subMerchantForm .material-outline input.form-control:not(:focus):not(:placeholder-shown)~label,
                #subMerchantForm .material-outline select.form-select:not(:focus)~label {
                    color: #1a1a2e !important;
                } */

                /* Select2 resting label → black */
                #subMerchantForm .material-outline.has-select2 label {
                    color: #1a1a2e !important;
                    z-index: 5;
                    pointer-events: none;
                }

                #subMerchantForm .material-outline.has-select2.select2-focused label,
                #subMerchantForm .material-outline.has-select2.has-value label {
                    top: 0 !important;
                    transform: scale(.85) translateY(-0.5rem) translateX(0.15rem) !important;
                    background-color: white !important;
                    padding: 0 0.25rem !important;
                    color: var(--sm-primary) !important;
                }


                .sm-page-header {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    margin-bottom: 1.6rem;
                }

                .sm-header-left {
                    display: flex;
                    align-items: center;
                    gap: 0.85rem;
                }

                .sm-page-icon {
                    width: 44px;
                    height: 44px;
                    background: linear-gradient(135deg, var(--sm-primary), var(--sm-secondary));
                    border-radius: 12px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    color: #fff;
                    font-size: 1.25rem;
                    flex-shrink: 0;
                    box-shadow: 0 4px 14px rgba(0, 128, 128, 0.3);
                }

                .sm-page-title {
                    font-size: 1.3rem;
                    font-weight: 700;
                    color: var(--sm-text);
                    margin: 0;
                    line-height: 1.2;
                }

                .sm-page-subtitle {
                    font-size: 0.78rem;
                    color: var(--sm-muted);
                    margin: 0;
                    margin-top: 2px;
                }

                /* ===== MAIN FORM CARD (thick left border) ===== */
                .sm-form-card {
                    background: var(--sm-surface);
                    border: 1px solid var(--sm-border);
                    border-left: 5px solid var(--sm-primary);
                    border-radius: 12px;
                    box-shadow: 0 2px 16px rgba(0, 128, 128, 0.07);
                    overflow: hidden;
                    margin-bottom: 2rem;
                }

                /* ===== TAB NAV ===== */
                .sm-tab-header {
                    background: var(--sm-surface);
                    border-bottom: 1px solid var(--sm-border);
                    padding: 0 1.5rem;
                    overflow-x: auto;
                    -webkit-overflow-scrolling: touch;
                }
                
                /* Hide scrollbar for tabs */
                .sm-tab-header::-webkit-scrollbar {
                    display: none;
                }

                .sm-nav-tabs {
                    display: flex;
                    gap: 0;
                    list-style: none;
                    margin: 0;
                    padding: 0;
                    border: none;
                }

                .sm-nav-tabs .sm-tab-btn {
                    background: transparent;
                    border: none;
                    padding: 1rem 1.4rem;
                    font-size: 0.875rem;
                    font-weight: 500;
                    color: var(--sm-muted);
                    cursor: pointer;
                    display: flex;
                    align-items: center;
                    gap: 0.45rem;
                    position: relative;
                    transition: color 0.2s;
                    white-space: nowrap;
                    outline: none;
                }

                .sm-nav-tabs .sm-tab-btn i {
                    font-size: 1rem;
                    transition: color 0.2s;
                }

                .sm-nav-tabs .sm-tab-btn:hover {
                    color: var(--sm-primary);
                }

                .sm-nav-tabs .sm-tab-btn::after {
                    content: '';
                    position: absolute;
                    bottom: 0;
                    left: 0;
                    right: 0;
                    height: 3px;
                    background: linear-gradient(135deg, var(--sm-primary), var(--sm-secondary));
                    border-radius: 3px 3px 0 0;
                    transform: scaleX(0);
                    transition: transform 0.2s;
                }

                .sm-nav-tabs .sm-tab-btn.active {
                    color: var(--sm-text);
                    font-weight: 600;
                }

                .sm-nav-tabs .sm-tab-btn.active i {
                    color: var(--sm-primary);
                }

                .sm-nav-tabs .sm-tab-btn.active::after {
                    transform: scaleX(1);
                }

                .sm-nav-tabs .sm-tab-btn:disabled,
                .sm-nav-tabs .sm-tab-btn[disabled] {
                    opacity: 0.4;
                    cursor: not-allowed;
                    pointer-events: none;
                }

                /* ===== TAB CONTENT ===== */
                .sm-tab-body {
                    padding: 1rem 1.25rem 0.75rem;
                }

                .sm-tab-pane {
                    display: none;
                }

                .sm-tab-pane.active {
                    display: block;
                }

                /* ===== SECTION LABEL ===== */
                .sm-section-label {
                    font-size: 0.72rem;
                    font-weight: 700;
                    color: var(--sm-primary);
                    text-transform: uppercase;
                    letter-spacing: 0.07em;
                    margin-bottom: 1.1rem;
                    display: flex;
                    align-items: center;
                    gap: 0.4rem;
                }

                /* ===== DIVIDER ===== */
                .sm-divider {
                    border: none;
                    border-top: 1px solid var(--sm-border);
                    margin: 1.25rem 0;
                }

                /* ===== HINT TEXT ===== */
                .sm-hint {
                    font-size: 0.75rem;
                    color: #e74c3c;
                    font-weight: 600;
                    margin-top: 4px;
                    padding-left: 2px;
                }

                /* ===== BUTTONS ===== */
                .btn-sm-primary {
                    background: linear-gradient(135deg, var(--sm-primary), var(--sm-secondary));
                    border: none;
                    color: #fff;
                    border-radius: 8px;
                    padding: 0.55rem 1.5rem;
                    font-size: 0.875rem;
                    font-weight: 600;
                    letter-spacing: 0.02em;
                    transition: all 0.2s;
                    display: inline-flex;
                    align-items: center;
                    gap: 0.4rem;
                    box-shadow: 0 4px 14px rgba(0, 128, 128, 0.25);
                    cursor: pointer;
                }

                .btn-sm-primary:hover {
                    opacity: 0.92;
                    transform: translateY(-1px);
                    box-shadow: 0 6px 20px rgba(0, 128, 128, 0.35);
                    color: #fff;
                }

                .btn-sm-primary:disabled {
                    opacity: 0.65;
                    transform: none;
                }

                .btn-sm-secondary {
                    background: transparent;
                    border: 1.5px solid var(--sm-primary);
                    color: var(--sm-primary);
                    border-radius: 8px;
                    padding: 0.52rem 1.4rem;
                    font-size: 0.875rem;
                    font-weight: 600;
                    transition: all 0.2s;
                    display: inline-flex;
                    align-items: center;
                    gap: 0.4rem;
                    cursor: pointer;
                }

                .btn-sm-secondary:hover {
                    background: linear-gradient(135deg, var(--sm-primary), var(--sm-secondary));
                    color: #fff;
                    border-color: transparent;
                    box-shadow: 0 4px 14px rgba(0, 128, 128, 0.25);
                }

                .btn-sm-success {
                    background: linear-gradient(135deg, var(--sm-primary), var(--sm-secondary));
                    border: none;
                    color: #fff;
                    border-radius: 8px;
                    padding: 0.55rem 1.5rem;
                    font-size: 0.875rem;
                    font-weight: 600;
                    letter-spacing: 0.02em;
                    transition: all 0.2s;
                    display: inline-flex;
                    align-items: center;
                    gap: 0.4rem;
                    box-shadow: 0 4px 14px rgba(16, 185, 129, 0.25);
                    cursor: pointer;
                }

                .btn-sm-success:hover {
                    opacity: 0.92;
                    transform: translateY(-1px);
                    box-shadow: 0 6px 20px rgba(0, 128, 128, 0.35);
                    color: #fff;
                }

                /* ===== STEP FOOTER AREA ===== */
                .sm-step-footer {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    margin-top: 0.6rem;
                    padding-top: 0.6rem;
                    border-top: 1px solid var(--sm-border);
                }

                .sm-step-footer.end {
                    justify-content: flex-end;
                }

                /* ===== STEP PROGRESS DOTS ===== */
                .sm-step-dots {
                    display: flex;
                    align-items: center;
                    gap: 0.5rem;
                }

                .sm-dot {
                    width: 8px;
                    height: 8px;
                    border-radius: 50%;
                    background: var(--sm-border);
                    transition: all 0.25s;
                }

                .sm-dot.active {
                    background: var(--sm-primary);
                    width: 22px;
                    border-radius: 4px;
                }

                .sm-dot.done {
                    background: var(--sm-primary);
                    opacity: 0.4;
                }

                /* ===== ADDRESS SUGGESTIONS ===== */
                #address-suggestions {
                    border: 1px solid var(--sm-border);
                    border-radius: 8px;
                    overflow: hidden;
                    box-shadow: 0 4px 16px rgba(0, 128, 128, 0.1);
                }

                #address-suggestions .list-group-item {
                    font-size: 0.83rem;
                    padding: 0.55rem 1rem;
                    cursor: pointer;
                    transition: background 0.15s;
                }

                #address-suggestions .list-group-item:hover {
                    background: var(--sm-primary-soft);
                    color: var(--sm-primary);
                }

                /* ===== GOOGLE MAPS AUTOCOMPLETE ===== */
                .pac-container {
                    z-index: 10500 !important;
                    min-width: 300px !important;
                    border-radius: 8px;
                    border: 1px solid var(--sm-border);
                    box-shadow: 0 4px 16px rgba(0, 128, 128, 0.12);
                }

                @media (max-width: 767px) {
                    .sm-tab-btn {
                        padding: 0.75rem 0.85rem;
                        font-size: 0.8rem;
                    }

                    .sm-tab-body {
                        padding: 1.25rem 1rem;
                    }

                    .sm-page-header {
                        flex-direction: column;
                        align-items: flex-start;
                        gap: 0.75rem;
                    }
                }

                /* ===== TEXTAREA LABEL FIX ===== */
                .material-outline textarea.form-control {
                    padding-top: 1rem;
                }
                .material-outline textarea.form-control ~ label {
                    top: 1rem;
                    height: auto;
                    transform: translateY(-50%);
                }

                .material-outline textarea.form-control:focus ~ label,
                .material-outline textarea.form-control:not(:placeholder-shown) ~ label,
                .material-outline.has-value textarea.form-control ~ label,
                .material-outline textarea.form-control[readonly] ~ label {
                    top: 0;
                    transform: scale(.85) translateY(-0.5rem) translateX(0.15rem);
                    background-color: white;
                    padding: 0 0.25rem;
                    z-index: 2;
                    color: var(--sm-text, #1a1a2e);
                }
            </style>

            <!-- ============================
     PAGE HEADER
     ============================ -->
            <div class="sm-page-header">
                <div class="sm-header-left">
                    <div class="sm-page-icon">
                        <i class="bi bi-person-plus-fill"></i>
                    </div>
                    <div>
                        <h1 class="sm-page-title">Sub Merchant Onboarding</h1>
                        <p class="sm-page-subtitle">Register a new sub-merchant into the Levant API ecosystem</p>
                    </div>
                </div>
                <div class="sm-header-right">
                    <a href="/admin/merchants" class="btn" style="background: linear-gradient(135deg, var(--sm-primary), var(--sm-secondary)); color: white; border: none; border-radius: 8px; font-weight: 600; padding: 0.6rem 1.2rem; box-shadow: 0 4px 12px rgba(0, 128, 128, 0.25);">
                        <i class="bi bi-arrow-left me-1"></i> Back to List
                    </a>
                </div>
            </div>

            <!-- ============================
     MAIN FORM CARD
     ============================ -->
            <div class="sm-form-card">

                <!-- Tab Navigation -->
                <div class="sm-tab-header">
                    <div class="sm-nav-tabs" role="tablist">
                        <button class="sm-tab-btn active" id="tab-personal" role="tab" onclick="switchTab('personal')">
                            <i class="bi bi-person-badge-fill"></i> Personal Details
                        </button>
                        <button class="sm-tab-btn" id="tab-personal-address" role="tab" onclick="switchTab('personal-address')" disabled>
                            <i class="bi bi-geo-alt-fill"></i> Personal Address
                        </button>
                        <button class="sm-tab-btn" id="tab-business" role="tab" onclick="switchTab('business')"
                            disabled>
                            <i class="bi bi-briefcase-fill"></i> Business Details
                        </button>
                        <button class="sm-tab-btn" id="tab-location" role="tab" onclick="switchTab('location')"
                            disabled>
                            <i class="bi bi-pin-map-fill"></i> Business Address
                        </button>
                    </div>
                </div>

                <!-- Tab Body -->
                <div class="sm-tab-body">
                    <form action="/admin/submerchant/submerchant_onboard" method="POST" id="subMerchantForm">

                        <!-- ========================
                 TAB 1: PERSONAL DETAILS
                 ======================== -->
                        <div class="sm-tab-pane active" id="pane-personal">
                            <div class="sm-section-label">
                                <i class="bi bi-person-lines-fill"></i> Personal Information
                            </div>
                            <div class="row g-2">
                                <div class="col-md-6">
                                    <div class="material-outline">
                                        <input type="text" class="form-control" id="name" name="name"
                                            placeholder="Merchant Name" required oninput="if(this.value && !document.getElementById('primary_vpa').dataset.edited) { document.getElementById('primary_vpa').value = this.value.toLowerCase().replace(/[^a-z0-9]/g, '') + '@synergicpay'; document.getElementById('primary_vpa').closest('.material-outline').classList.add('has-value'); }">
                                        <label for="name">Merchant Name (KYC) <span class="text-danger">*</span></label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="material-outline">
                                        <input type="text" class="form-control" id="name_on_bank" name="name_on_bank"
                                            placeholder="Name on Bank" required>
                                        <label for="name_on_bank">Bank Account Holder Name <span
                                                class="text-danger">*</span></label>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="material-outline mb-1">
                                        <input type="email" class="form-control" id="email" name="email"
                                            placeholder="Email Address" required>
                                        <label for="email">Merchant Email ID <span class="text-danger">*</span></label>
                                    </div>
                                    <div class="text-danger small ms-1" id="email_error" style="display:none; margin-top: -12px; margin-bottom: 10px;">Please enter a valid Email ID</div>
                                </div>
                                <div class="col-md-6">
                                    <div class="material-outline mb-1">
                                        <input type="tel" class="form-control" id="phone" name="phone"
                                            placeholder="Phone Number" required pattern="^[6-9]\d{9}$" maxlength="10"
                                            title="Please enter a valid 10-digit phone number">
                                        <label for="phone">Merchant Mobile Number <span
                                                class="text-danger">*</span></label>
                                    </div>
                                    <div class="text-danger small ms-1" id="phone_error" style="display:none; margin-top: -12px; margin-bottom: 10px;">Please enter a valid 10-digit Mobile Number</div>
                                </div>

                                <div class="col-md-6">
                                    <div class="material-outline">
                                        <input type="text" class="form-control" id="primary_vpa" name="primary_vpa"
                                            placeholder="Primary VPA" required oninput="this.dataset.edited = true;">
                                        <label for="primary_vpa">Primary VPA <span class="text-danger">*</span></label>
                                    </div>
                                </div>
                            </div>
                            <div class="sm-step-footer end" style="margin-top: 0.5rem; padding-top: 0.75rem;">
                                <div class="sm-step-dots">
                                    <div class="sm-dot active" id="dot-1"></div>
                                    <div class="sm-dot" id="dot-2"></div>
                                    <div class="sm-dot" id="dot-3"></div>
                                    <div class="sm-dot" id="dot-4"></div>
                                </div>
                                <button type="button" class="btn-sm-primary ms-auto" id="next-to-personal-address">
                                    Next Step <i class="bi bi-arrow-right"></i>
                                </button>
                            </div>
                        </div>

                        <!-- ========================
                 TAB 1.5: PERSONAL ADDRESS
                 ======================== -->
                        <div class="sm-tab-pane" id="pane-personal-address">
                            <div class="sm-section-label">
                                <i class="bi bi-geo-alt-fill"></i> Personal Address
                            </div>
                            <div class="row g-2">
                                <div class="col-md-12">
                                    <div class="mb-3">
                                        <label for="personal_address_1" class="form-label text-muted small fw-bold mb-1" style="margin-bottom: 6px;">Address Line 1 <span class="text-danger">*</span></label>
                                        <textarea class="form-control border" id="personal_address_1" name="personal_address_1" placeholder="Address Line 1" rows="3" required style="border-radius: 8px;" onpaste="return false;"></textarea>
                                    </div>
                                </div>
                                <div class="col-md-12">
                                    <div class="mb-3">
                                        <label for="personal_address_2" class="form-label text-muted small fw-bold mb-1" style="margin-bottom: 6px;">Address Line 2</label>
                                        <textarea class="form-control border" id="personal_address_2" name="personal_address_2" placeholder="Address Line 2" rows="3" style="border-radius: 8px;" onpaste="return false;"></textarea>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="material-outline">
                                        <select class="form-select" id="personal_district" name="personal_district" required>
                                            <option value="" selected>Select District</option>
                                            <option value="Alipurduar">Alipurduar</option>
                                            <option value="Bankura">Bankura</option>
                                            <option value="Birbhum">Birbhum</option>
                                            <option value="CoochBihar">CoochBihar</option>
                                            <option value="Dakshin Dinajpur">Dakshin Dinajpur</option>
                                            <option value="Darjeeling">Darjeeling</option>
                                            <option value="Hooghly">Hooghly</option>
                                            <option value="Howrah">Howrah</option>
                                            <option value="Jalpaiguri">Jalpaiguri</option>
                                            <option value="Jhargram">Jhargram</option>
                                            <option value="Kalimpong">Kalimpong</option>
                                            <option value="Kolkata">Kolkata</option>
                                            <option value="Malda">Malda</option>
                                            <option value="Murshidabad">Murshidabad</option>
                                            <option value="Nadia">Nadia</option>
                                            <option value="North 24 Parganas">North 24 Parganas</option>
                                            <option value="Paschim Bardhaman">Paschim Bardhaman</option>
                                            <option value="Purba Bardhaman">Purba Bardhaman</option>
                                            <option value="Paschim Medinipur">Paschim Medinipur</option>
                                            <option value="Purba Medinipur">Purba Medinipur</option>
                                            <option value="Purulia">Purulia</option>
                                            <option value="South 24 Parganas">South 24 Parganas</option>
                                            <option value="Uttar Dinajpur">Uttar Dinajpur</option>
                                            <option value="Ganjam">Ganjam</option>
                                            <option value="Cuttack">Cuttack</option>
                                            <option value="Mayurbhanj">Mayurbhanj</option>
                                            <option value="Baleshwar">Baleshwar</option>
                                            <option value="Khordha">Khordha</option>
                                            <option value="Sundargarh">Sundargarh</option>
                                            <option value="Jajapur">Jajapur</option>
                                            <option value="Kendujhar">Kendujhar</option>
                                            <option value="Puri">Puri</option>
                                            <option value="Balangir">Balangir</option>
                                            <option value="Kalahandi">Kalahandi</option>
                                            <option value="Bhadrak">Bhadrak</option>
                                            <option value="Bargarh">Bargarh</option>
                                            <option value="Kendrapara">Kendrapara</option>
                                            <option value="Koraput">Koraput</option>
                                            <option value="Anugul">Anugul</option>
                                            <option value="Nabarangapur">Nabarangapur</option>
                                            <option value="Dhenkanal">Dhenkanal</option>
                                            <option value="Jagatsinghapur">Jagatsinghapur</option>
                                            <option value="Sambalpur">Sambalpur</option>
                                            <option value="Rayagada">Rayagada</option>
                                            <option value="Nayagarh">Nayagarh</option>
                                            <option value="Kandhamal">Kandhamal</option>
                                            <option value="Malkangiri">Malkangiri</option>
                                            <option value="Nuapada">Nuapada</option>
                                            <option value="Subarnapur">Subarnapur</option>
                                            <option value="Jharsuguda">Jharsuguda</option>
                                            <option value="Gajapati">Gajapati</option>
                                            <option value="Baudh">Baudh</option>
                                            <option value="Debagarh">Debagarh</option>
                                        </select>
                                        <label for="personal_district">District <span class="text-danger">*</span></label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="material-outline">
                                        <input type="text" class="form-control" id="personal_pincode" name="personal_pincode" placeholder="Pin Code" required pattern="^[0-9]{6}$" title="Please enter a valid 6-digit PIN code.">
                                        <label for="personal_pincode">Pin Code <span class="text-danger">*</span></label>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="material-outline">
                                        <select class="form-select" id="personal_state" name="personal_state" required>
                                            <option value="" selected>Select State</option>
                                        </select>
                                        <label for="personal_state">State <span class="text-danger">*</span></label>
                                    </div>
                                </div>
                                <!-- <div class="col-md-4">
                                    <div class="material-outline mb-1">
                                        <input type="tel" class="form-control" id="personal_pincode" name="personal_pincode" placeholder="Pincode" required pattern="^\d{6}$" maxlength="6" minlength="6" title="Please enter a valid 6-digit Pincode">
                                        <label for="personal_pincode">Pin Code <span class="text-danger">*</span></label>
                                    </div>
                                </div> -->
                            </div>
