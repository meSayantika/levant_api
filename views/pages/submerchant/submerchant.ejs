<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center mb-4">
    <div>
        <h1 class="fs-4 fw-bold text-dark mb-1">Sub Merchant Onboarding</h1>
        <p class="text-muted small mb-0">Register a new sub-merchant into the Levant API ecosystem</p>
    </div>
</div>

<form action="/admin/submerchant/submerchant_onboard" method="POST" id="subMerchantForm">
    <div class="card border-0 rounded-4 shadow-sm mb-5">
        <div class="card-header bg-white border-bottom-0 rounded-top-4 px-4 pt-4 pb-0">
            <ul class="nav nav-tabs border-bottom" id="merchantTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active fw-medium px-4 py-3" id="personal-tab" data-bs-toggle="tab"
                        data-bs-target="#personal-tab-pane" type="button" role="tab" aria-controls="personal-tab-pane"
                        aria-selected="true">
                        <i class="bi bi-person-badge-fill me-2 text-primary"></i><span class="tab-label">Personal
                            Details</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-medium px-4 py-3" id="business-tab" data-bs-toggle="tab"
                        data-bs-target="#business-tab-pane" type="button" role="tab" aria-controls="business-tab-pane"
                        aria-selected="false" disabled>
                        <i class="bi bi-briefcase-fill me-2 text-primary"></i><span class="tab-label">Business
                            Details</span>
                    </button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link fw-medium px-4 py-3" id="location-tab" data-bs-toggle="tab"
                        data-bs-target="#location-tab-pane" type="button" role="tab" aria-controls="location-tab-pane"
                        aria-selected="false" disabled>
                        <i class="bi bi-geo-alt-fill me-2 text-primary"></i><span class="tab-label">Address
                            Details</span>
                    </button>
                </li>
            </ul>
        </div>

        <div class="card-body px-4 pb-3 pt-4">
            <div class="tab-content" id="merchantTabsContent">

                <div class="tab-pane fade show active" id="personal-tab-pane" role="tabpanel"
                    aria-labelledby="personal-tab" tabindex="0">
                    <style>
                        #personal-tab-pane .form-control {
                            border: 1px solid #0d6efd !important;
                        }
                    </style>
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="material-outline">
                                <input type="text" class="form-control" id="name" name="name"
                                    placeholder="Merchant Name" required>
                                <label for="name">Merchant Name (KYC) <span class="text-danger">*</span></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="material-outline">
                                <input type="text" class="form-control" id="name_on_bank" name="name_on_bank"
                                    placeholder="Name on Bank" required>
                                <label for="name_on_bank">Bank Account Holder Name<span
                                        class="text-danger">*</span></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="material-outline">
                                <input type="email" class="form-control" id="email" name="email"
                                    placeholder="Email Address" required>
                                <label for="email">Merchant Email ID <span class="text-danger">*</span></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="material-outline">
                                <input type="tel" class="form-control" id="phone" name="phone"
                                    placeholder="Phone Number" required pattern="^[6-9]\d{9}$" maxlength="10"
                                    title="Please enter a valid 10-digit phone number">
                                <label for="phone">Merchant Mobile Number <span class="text-danger">*</span></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="material-outline">
                                <input type="text" class="form-control" id="city" name="city" placeholder="City"
                                    required>
                                <label for="city">Merchant City <span class="text-danger">*</span></label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="material-outline">
                                <input type="tel" class="form-control" id="pincode" name="pincode" placeholder="Pincode"
                                    required pattern="^\d{6}$" maxlength="6" minlength="6"
                                    title="Please enter a valid 6-digit Pincode">
                                <label for="pincode">Merchant Pincode <span class="text-danger">*</span></label>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-end mt-2">
                        <button type="button" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm btn-sm"
                            id="next-to-business" style="color: white;
    background-color: #57a947; border-color: #061014;">
                            Next Step <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </div>
                </div>

                <div class="tab-pane fade" id="business-tab-pane" role="tabpanel" aria-labelledby="business-tab"
                    tabindex="0">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <div class="material-outline">
                                <input type="text" class="form-control" id="business_name" name="business_name"
                                    placeholder="Business Name" required>
                                <label for="business_name">Business / Shop Name <span
                                        class="text-danger">*</span></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="material-outline">
                                <select class="form-select" id="state" name="state" required>
                                    <option value="" selected>Select State</option>
                                </select>
                                <label for="state">State <span class="text-danger">*</span></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="material-outline">
                                <select class="form-select" id="nature_of_business" name="nature_of_business" required>
                                    <option value="" selected>Select Business Category Name</option>
                                </select>
                                <label for="nature_of_business">Business Category Name<span
                                        class="text-danger">*</span></label>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="material-outline">
                                <input type="text" class="form-control bg-light" id="category_code" name="category_code"
                                    placeholder="Category Code" required readonly>
                                <label for="category_code">Category Code <span class="text-danger">*</span></label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="material-outline">
                                <select class="form-select" id="business_type_code" name="business_type_code" required>
                                    <option value="" selected>Select Business Type Name</option>
                                </select>
                                <label for="business_type_code">Business Type Name <span
                                        class="text-danger">*</span></label>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="material-outline">
                                <input type="text" class="form-control" id="pan_no" name="pan_no"
                                    placeholder="PAN Number" required maxlength="10" minlength="10"
                                    oninput="this.value = this.value.toUpperCase()">
                                <label for="pan_no">PAN Number <span class="text-danger">*(e.g.
                                        ABCDE1234F)</span></label>
                            </div>
                        </div>
                    </div>
                    <div class="row g-3 mt-1">
                        <div class="col-12 position-relative">
                            <div class="material-outline">
                                <input type="text" class="form-control" id="business_address" name="business_address"
                                    placeholder="Business Address" required autocomplete="off">
                                <label for="business_address">Business Address <span
                                        class="text-danger">*</span></label>
                            </div>
                            <ul id="address-suggestions" class="list-group position-absolute w-100 shadow-sm"
                                style="display:none; z-index: 1050; max-height: 200px; overflow-y: auto;"></ul>
                            <div class="text-danger fw-bold"
                                style="font-size: 0.85rem; margin-top: 2px; padding-left: 4px;">(No special characters
                                are allowed (e.g. @, #, $, %, ^, &, *, !, ?, etc.))</div>
                        </div>
                    </div>
                    <div class="d-flex justify-content-between mt-4">
                        <button type="button" class="btn btn-info text-white px-4 py-2 rounded-3 shadow-sm"
                            id="prev-to-personal" style="background-color: #43788d; border-color: #102933;">
                            <i class="bi bi-arrow-left me-2"></i> Previous
                        </button>
                        <button type="button" class="btn btn-primary px-4 py-2 rounded-3 shadow-sm"
                            id="next-to-location" style="color: white;
    background-color: #57a947; border-color: #061014;">
                            Next Step <i class="bi bi-arrow-right ms-2"></i>
                        </button>
                    </div>
                </div>

                <div class="tab-pane fade" id="location-tab-pane" role="tabpanel" aria-labelledby="location-tab"
                    tabindex="0">
                    <div class="row g-3">
                        <div class="col-12">
                            <div class="material-outline">
                                <input type="text" class="form-control" id="address" name="address"
                                    placeholder="Aadhaar Address" required>
                                <label for="address">Aadhaar Address <span class="text-danger">*</span></label>
                            </div>
                            <div class="text-danger fw-bold" id="business_address_error"
                                style="font-size: 0.85rem; margin-top: 2px; padding-left: 4px;">(No special characters
                                are allowed (e.g. @, #, $, %, ^, &, *, !, ?, etc.))</div>
                        </div>
                    </div>
                    <div class="row g-3 mt-2">
                        <div class="col-md-4">
                            <div class="material-outline">
                                <select class="form-select" id="entity_type" name="entity_type" required>
                                    <option value="" selected>Select Entity Type Name</option>
                                </select>
                                <label for="entity_type">Entity Type Name <span class="text-danger">*</span></label>
                            </div>
                        </div>

                        <div class="col-md-4">
                            <div class="material-outline">
                                <input type="text" class="form-control" id="gstin" name="gstin"
                                    placeholder="GSTIN (Optional)">
                                <label for="gstin">GSTIN (Optional)</label>
                            </div>
                        </div>
                        <div class="col-md-4">
                            <div class="material-outline">
                                <input type="text" class="form-control" id="primary_vpa" name="primary_vpa"
                                    placeholder="Primary VPA" required>
                                <label for="primary_vpa">Primary VPA <span class="text-danger">*</span></label>
                            </div>
                        </div>

                        <!-- <div class="col-md-4">
                            <div class="material-outline">
                                <input type="number" class="form-control" id="entity_type" name="entity_type" placeholder="Entity Type" required>
                                <label for="entity_type">Entity Type Code <span class="text-danger">*</span></label>
                            </div>
                        </div> -->

                        <input type="hidden" id="lati" name="lati" value="0.0000">
                        <input type="hidden" id="longi" name="longi" value="0.0000">
                    </div>
                    <div class="d-flex justify-content-between mt-5 pt-3 border-top">
                        <button type="button" class="btn btn-info text-white px-4 py-2 rounded-3 shadow-sm"
                            id="prev-to-business" style="background-color: #43788d; border-color: #102933;">
                            <i class="bi bi-arrow-left me-2"></i> Previous
                        </button>
                        <div>
                            <!-- <button type="reset" class="btn btn-light px-4 py-2 me-3 rounded-3 shadow-sm fw-medium border">Clear Form</button> -->
                            <button type="submit" class="btn btn-primary px-5 py-2 rounded-3 shadow-sm fw-semibold"
                                style="color: white;
    background-color: #57a947; border-color: #061014;">
                                <i class="bi bi-cloud-upload-fill me-2"></i> Submit SubMerchant
                            </button>
                        </div>
                    </div>
                </div>

            </div>
        </div>
<style>
    /* Force Google Maps Autocomplete dropdown to appear above Bootstrap tabs/modals */
    .pac-container {
        z-index: 10500 !important;
        min-width: 300px !important;
    }
</style>

<script type="text/javascript" src="https://maps.googleapis.com/maps/api/js?libraries=places&key=AIzaSyDANjx3bosEtIyzJaoWs50Wnt6nt_1rmxU"></script>
<script type="text/javascript" src="/autocomplete.js"></script>

<script>
    // Remove existing handlers to prevent double binding on re-renders
    $(document).off('submit', '#subMerchantForm');

    // 2. Handle Form Submission
    $(document).on('submit', '#subMerchantForm', function (e) {
        e.preventDefault(); // Prevent standard form submission

        var $form = $(this);
        var $submitBtn = $form.find('button[type="submit"]');
        var originalBtnText = $submitBtn.html();
        $submitBtn.prop('disabled', true).html('<span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span> Processing...');

        // Helper function to submit via AJAX after coordinates are resolved
        function executeAjaxSubmission() {
            var formData = $form.serialize();

            $.ajax({
                url: $form.attr('action'),
                type: 'POST',
                data: formData,
                success: function (response) {
                    $submitBtn.prop('disabled', false).html(originalBtnText);

                    if (response.success) {
                        // Show success message
                        alert(response.message || 'Sub-merchant onboarded successfully!');
                        // Refresh the page to clear the form and load fresh data
                        window.location.reload();
                    } else {
                        // Show error message
                        alert('Error: ' + (response.message || 'Failed to onboard sub-merchant.'));
                    }
                },
                error: function (xhr, status, error) {
                    $submitBtn.prop('disabled', false).html(originalBtnText);
                    alert('An unexpected error occurred. Please try again.');
                    console.error("Submission Error:", error);
                }
            });
        }
        
        // Actually call the function to submit the form!
        executeAjaxSubmission();
    });

</script>