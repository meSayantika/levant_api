<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Synergic Pay Admin Login - Secure Access to Payment Management">
    <title><%= typeof title !== 'undefined' ? title : 'Login | Synergic Pay' %></title>

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
        /* ---- Login Page Scoped Styles ---- */
        * { font-family: 'Inter', sans-serif; }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #f5f7ff 0%, #e8ecf8 30%, #f0e6f6 60%, #fce4ec 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow: hidden;
        }

        /* Animated floating shapes */
        .sp-login-bg {
            position: fixed; inset: 0; z-index: 0; overflow: hidden;
        }
        .sp-login-bg .shape {
            position: absolute;
            border-radius: 50%;
            opacity: 0.12;
            animation: floatShape 18s ease-in-out infinite;
        }
        .sp-login-bg .shape-1 {
            width: 400px; height: 400px;
            background: linear-gradient(135deg, #667eea, #764ba2);
            top: -100px; right: -80px;
            animation-delay: 0s;
        }
        .sp-login-bg .shape-2 {
            width: 300px; height: 300px;
            background: linear-gradient(135deg, #f093fb, #f5576c);
            bottom: -60px; left: -60px;
            animation-delay: -6s;
        }
        .sp-login-bg .shape-3 {
            width: 200px; height: 200px;
            background: linear-gradient(135deg, #4facfe, #00f2fe);
            top: 50%; left: 50%;
            transform: translate(-50%, -50%);
            animation-delay: -12s;
        }

        @keyframes floatShape {
            0%, 100% { transform: translateY(0) rotate(0deg) scale(1); }
            33% { transform: translateY(-30px) rotate(120deg) scale(1.05); }
            66% { transform: translateY(20px) rotate(240deg) scale(0.95); }
        }

        .sp-login-container {
            position: relative; z-index: 1;
            width: 100%; max-width: 470px;
            padding: 0 1rem;
        }

        .sp-login-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 24px;
            padding: 1rem 2.5rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08),
                        0 1px 3px rgba(0, 0, 0, 0.04);
            animation: slideUp 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        }

        @keyframes slideUp {
            from { opacity: 0; transform: translateY(40px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .sp-brand-logo {
            width: 56px; height: 56px;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1.5rem;
            box-shadow: 0 8px 24px rgba(102, 126, 234, 0.3);
        }

        .sp-login-title {
            font-size: 1.5rem; font-weight: 700;
            color: #1a1a2e; margin-bottom: 0.25rem;
        }

        .sp-login-subtitle {
            color: #7c7c8d; font-size: 0.9rem;
            margin-bottom: 1.5rem;
        }

        .sp-form-group {
            margin-bottom: 1.25rem;
        }

        .sp-form-group label {
            font-size: 0.8rem; font-weight: 600;
            color: #4a4a5a; margin-bottom: 0.4rem;
            display: block; letter-spacing: 0.3px;
        }

        .sp-form-group .input-group {
            border: 2px solid #e8e8f0;
            border-radius: 12px;
            overflow: hidden;
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .sp-form-group .input-group:focus-within {
            border-color: #667eea;
            box-shadow: 0 0 0 4px rgba(102, 126, 234, 0.1);
        }

        .sp-form-group .input-group-text {
            background: transparent; border: none;
            color: #9e9eb8; padding: 0.75rem 0.9rem;
        }

        .sp-form-group .form-control {
            border: none; background: transparent;
            padding: 0.75rem 0.9rem 0.75rem 0;
            font-size: 0.95rem; color: #1a1a2e;
        }

        .sp-form-group .form-control:focus {
            box-shadow: none; outline: none;
        }

        .sp-form-group .form-control::placeholder {
            color: #b8b8cc;
        }

        .sp-toggle-pw {
            background: transparent; border: none;
            color: #9e9eb8; cursor: pointer;
            padding: 0.75rem 0.9rem;
            transition: color 0.2s;
        }

        .sp-toggle-pw:hover { color: #667eea; }

        .sp-btn-login {
            width: 100%;
            padding: 0.85rem;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border: none; border-radius: 12px;
            color: #fff; font-size: 1rem;
            font-weight: 600; letter-spacing: 0.3px;
            cursor: pointer;
            transition: transform 0.2s, box-shadow 0.2s;
            position: relative; overflow: hidden;
        }

        .sp-btn-login:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 25px rgba(102, 126, 234, 0.35);
        }

        .sp-btn-login:active { transform: translateY(0); }

        .sp-btn-login .spinner-border {
            display: none; width: 1.2rem; height: 1.2rem;
        }

        .sp-btn-login.loading .spinner-border { display: inline-block; }
        .sp-btn-login.loading .btn-text { display: none; }

        .sp-error-alert {
            background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%);
            border: 1px solid #fecaca;
            color: #b91c1c;
            border-radius: 12px;
            padding: 0.75rem 1rem;
            font-size: 0.85rem;
            margin-bottom: 1.25rem;
            animation: shake 0.4s ease;
        }

        @keyframes shake {
            0%, 100% { transform: translateX(0); }
            20% { transform: translateX(-6px); }
            40% { transform: translateX(6px); }
            60% { transform: translateX(-4px); }
            80% { transform: translateX(4px); }
        }
    </style>
</head>
<body>
    <!-- Animated Background Shapes -->
    <div class="sp-login-bg">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
        <div class="shape shape-3"></div>
    </div>

    <!-- Login Card -->
    <div class="sp-login-container">
        <div class="sp-login-card">
            <!-- Brand Logo -->
            <div class="sp-brand-logo">
                <i class="bi bi-qr-code-scan text-white fs-3"></i>
            </div>

            <!-- Title -->
            <h1 class="sp-login-title text-center">Welcome Back</h1>
            <p class="sp-login-subtitle text-center" id="panelTitle">Sign in to Synergic Pay Admin Panel</p>

            <!-- Smoothly Expanding Error Space -->
            <div id="errorWrapper" style="max-height: <%= (typeof error !== 'undefined' && error) ? '100px' : '0' %>; overflow: hidden; transition: max-height 0.4s ease-out;">
                <div id="errorContainer" style="padding-bottom: 1rem;">
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="sp-error-alert d-flex align-items-center gap-2 mb-0" id="loginErrorAlert" style="padding: 0.5rem 0.8rem; border-radius: 8px;">
                            <i class="bi bi-exclamation-circle-fill" style="font-size: 0.9rem;"></i>
                            <span id="errorText" style="font-size: 0.8rem;"><%= error %></span>
                        </div>
                    <% } %>
                </div>
            </div>

            <!-- Login Form -->
            <form action="/admin/login" method="POST" id="loginForm">
                <!-- Username (Email) -->
                <div class="sp-form-group">
                    <label for="username">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-envelope-fill"></i>
                        </span>
                        <input type="email" class="form-control" id="username" name="username"
                               placeholder="Enter your email address" required autocomplete="username" autofocus
                               value="<%= typeof savedEmail !== 'undefined' ? savedEmail : '' %>">
                    </div>
                </div>

                <!-- Password -->
                <div class="sp-form-group">
                    <label for="password">Password</label>
                    <div class="input-group">
                        <span class="input-group-text">
                            <i class="bi bi-lock-fill"></i>
                        </span>
                        <input type="password" class="form-control" id="password" name="password"
                               placeholder="Enter your password" required autocomplete="current-password">
                        <button type="button" class="sp-toggle-pw" id="togglePassword">
                            <i class="bi bi-eye-fill"></i>
                        </button>
                    </div>
                </div>

                <!-- Remember Me & Forgot -->
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="rememberMe" name="rememberMe" <%= (typeof savedEmail !== 'undefined' && savedEmail) ? 'checked' : '' %>>
                        <label class="form-check-label small text-muted" for="rememberMe">Remember me</label>
                    </div>
                    <a href="/admin/forgot-password" class="small text-decoration-none" style="color: #667eea;">Forgot Password?</a>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="sp-btn-login" id="loginBtn">
                    <span class="btn-text">Sign In</span>
                    <span class="spinner-border spinner-border-sm" role="status"></span>
                </button>
            </form>

            <!-- Footer Text -->
            <p class="text-center text-muted small mt-4 mb-0">
                Secured by <strong style="color: #667eea;">Synergic Pay</strong> &copy; <%= new Date().getFullYear() %>
            </p>
        </div>
    </div>

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
            crossorigin="anonymous"></script>

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            // Check for flash success cookie
            const successMatch = document.cookie.match(new RegExp('(^| )sp_flash_success=([^;]+)'));
            if (successMatch) {
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: decodeURIComponent(successMatch[2]),
                    timer: 3000,
                    showConfirmButton: false
                });
                document.cookie = "sp_flash_success=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
            }

            // Client-side flash error handler for rendering the inline alert
            const errorMatch = document.cookie.match(new RegExp('(^| )sp_flash_error=([^;]+)'));
            if (errorMatch) {
                const flashErr = decodeURIComponent(errorMatch[2]);
                const errorHtml = `
                    <div class="sp-error-alert d-flex align-items-center gap-2 mb-0" id="loginErrorAlert" style="padding: 0.5rem 0.8rem; border-radius: 8px;">
                        <i class="bi bi-exclamation-circle-fill" style="font-size: 0.9rem;"></i>
                        <span id="errorText" style="font-size: 0.8rem;">${flashErr}</span>
                    </div>
                `;
                $("#errorContainer").html(errorHtml);
                $("#errorWrapper").css("max-height", "100px");
                document.cookie = "sp_flash_error=; expires=Thu, 01 Jan 1970 00:00:00 UTC; path=/;";
            }

            // ---- Toggle Password Visibility ----
            $("#togglePassword").on("click", function () {
                var $pwField = $("#password");
                var $icon = $(this).find("i");

                if ($pwField.attr("type") === "password") {
                    $pwField.attr("type", "text");
                    $icon.removeClass("bi-eye-fill").addClass("bi-eye-slash-fill");
                } else {
                    $pwField.attr("type", "password");
                    $icon.removeClass("bi-eye-slash-fill").addClass("bi-eye-fill");
                }
            });

            // ---- AJAX Check User Type on Email Blur ----
            $("#username").on("blur", function() {
                const email = $(this).val();
                if (email && email.includes('@')) {
                    $.get('/admin/api/v1/auth/check-user-type', { email: email })
                        .done(function(res) {
                            if (res.success && res.userType === 'S') {
                                $("#panelTitle").text("Sign in to Synergic Pay Merchant Panel");
                            } else {
                                $("#panelTitle").text("Sign in to Synergic Pay Admin Panel");
                            }
                        });
                } else {
                    $("#panelTitle").text("Sign in to Synergic Pay Admin Panel");
                }
            });
            
            // Trigger blur on load in case email was remembered
            if ($("#username").val()) {
                $("#username").trigger("blur");
            }

            // ---- Login Form Submit Handler ----
            $("#loginForm").on("submit", function (e) {
                const email = $("#username").val();
                if (!email || !email.includes('@')) {
                    e.preventDefault();
                    // Render the beautiful inline alert in the reserved space
                    const errorHtml = `
                        <div class="sp-error-alert d-flex align-items-center gap-2 mb-0" id="loginErrorAlert" style="padding: 0.5rem 0.8rem; border-radius: 8px;">
                            <i class="bi bi-exclamation-circle-fill" style="font-size: 0.9rem;"></i>
                            <span id="errorText" style="font-size: 0.8rem;">Invalid Email.</span>
                        </div>
                    `;
                    $("#errorContainer").html(errorHtml);
                    $("#errorWrapper").css("max-height", "100px");
                    return;
                }
                
                // Clear any inline errors and restore smooth height
                $("#errorWrapper").css("max-height", "0");
                setTimeout(() => $("#errorContainer").empty(), 400);
                
                var $btn = $("#loginBtn");
                $btn.addClass("loading").prop("disabled", true);
            });
        });
    </script>
</body>
</html>
