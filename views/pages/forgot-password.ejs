<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'Forgot Password | Synergic Pay' %></title>
    
    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- SweetAlert2 -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet">

    <style>
        * { font-family: 'Inter', sans-serif; }

        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #f0fdfa 0%, #e6fcf5 30%, #e0f2fe 60%, #f0fdfa 100%);
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow: hidden;
        }

        .sp-login-bg { position: fixed; inset: 0; z-index: 0; overflow: hidden; }
        .shape { position: absolute; border-radius: 50%; opacity: 0.12; animation: floatShape 18s ease-in-out infinite; }
        .shape-1 { width: 400px; height: 400px; background: linear-gradient(135deg, #008080, #004d40); top: -100px; right: -80px; animation-delay: 0s; }
        .shape-2 { width: 300px; height: 300px; background: linear-gradient(135deg, #20b2aa, #008080); bottom: -60px; left: -60px; animation-delay: -6s; }
        
        @keyframes floatShape {
            0%, 100% { transform: translateY(0) rotate(0deg) scale(1); }
            33% { transform: translateY(-30px) rotate(120deg) scale(1.05); }
            66% { transform: translateY(20px) rotate(240deg) scale(0.95); }
        }

        .sp-login-container { position: relative; z-index: 1; width: 100%; max-width: 470px; padding: 0 1rem; }
        .sp-login-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, 0.6);
            border-radius: 24px; padding: 2rem 2.5rem;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08);
            animation: slideUp 0.6s cubic-bezier(0.22, 1, 0.36, 1);
        }

        @keyframes slideUp { from { opacity: 0; transform: translateY(40px); } to { opacity: 1; transform: translateY(0); } }

        .sp-brand-logo {
            width: 56px; height: 56px;
            background: linear-gradient(135deg, #008080 0%, #32a995 100%);
            border-radius: 16px; display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1.5rem; box-shadow: 0 8px 24px rgba(0, 128, 128, 0.3);
        }

        .sp-login-title { font-size: 1.5rem; font-weight: 700; color: #1a1a2e; margin-bottom: 0.25rem; text-align: center; }
        .sp-login-subtitle { color: #7c7c8d; font-size: 0.9rem; margin-bottom: 2rem; text-align: center; }
        
        .sp-form-group { margin-bottom: 1.25rem; }
        .sp-form-group label { font-size: 0.8rem; font-weight: 600; color: #4a4a5a; margin-bottom: 0.4rem; display: block; }
        .input-group { border: 2px solid #e8e8f0; border-radius: 12px; overflow: hidden; transition: 0.3s; }
        .input-group:focus-within { border-color: #008080; box-shadow: 0 0 0 4px rgba(0, 128, 128, 0.1); }
        .input-group-text { background: transparent; border: none; color: #9e9eb8; padding: 0.75rem 0.9rem; }
        .form-control { border: none; background: transparent; padding: 0.75rem 0.9rem 0.75rem 0; }
        .form-control:focus { box-shadow: none; outline: none; }

        .sp-btn-login {
            width: 100%; padding: 0.85rem; background: linear-gradient(135deg, #008080 0%, #32a995 100%);
            border: none; border-radius: 12px; color: #fff; font-weight: 600; cursor: pointer; transition: 0.2s;
        }
        .sp-btn-login:hover { transform: translateY(-2px); box-shadow: 0 8px 25px rgba(0, 128, 128, 0.35); }

        @media (max-width: 576px) {
            .sp-login-card { padding: 1.5rem 1.25rem; }
            .sp-login-title { font-size: 1.25rem; }
        }
    </style>
</head>
<body>
    <div class="sp-login-bg">
        <div class="shape shape-1"></div>
        <div class="shape shape-2"></div>
    </div>

    <div class="sp-login-container">
        <div class="sp-login-card">
            <h1 class="sp-login-title">Reset Password</h1>
            <p class="sp-login-subtitle" style="margin-bottom: 1.5rem;">
                Enter your email address and we'll send you a link to reset your password.
            </p>

            <!-- Smoothly Expanding Error Space -->
            <div id="errorWrapper" style="max-height: <%= ((typeof error !== 'undefined' && error) || (typeof success !== 'undefined' && success)) ? '100px' : '0' %>; overflow: hidden; transition: max-height 0.4s ease-out;">
                <div id="errorContainer" style="padding-bottom: 1rem;">
                    <% if (typeof error !== 'undefined' && error) { %>
                        <div class="sp-error-alert d-flex align-items-center gap-2 mb-0" style="background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%); border: 1px solid #fecaca; color: #b91c1c; border-radius: 8px; padding: 0.5rem 0.8rem; font-size: 0.8rem;">
                            <i class="bi bi-exclamation-circle-fill" style="font-size: 0.9rem;"></i>
                            <span id="errorText"><%= error %></span>
                        </div>
                    <% } %>
                    <% if (typeof success !== 'undefined' && success) { %>
                        <div class="sp-error-alert d-flex align-items-center gap-2 mb-0" style="background: linear-gradient(135deg, #f0fdf4 0%, #dcfce7 100%); border: 1px solid #bbf7d0; color: #15803d; border-radius: 8px; padding: 0.5rem 0.8rem; font-size: 0.8rem;">
                            <i class="bi bi-check-circle-fill" style="font-size: 0.9rem;"></i>
                            <span id="errorText"><%- success %></span>
                        </div>
                    <% } %>
                </div>
            </div>

            <form action="/admin/forgot-password" method="POST" id="forgotForm">
                <div class="sp-form-group">
                    <label for="email">Email Address</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-envelope-fill"></i></span>
                        <input type="email" class="form-control" id="email" name="email" placeholder="Enter your email" required autofocus>
                    </div>
                </div>

                <button type="submit" class="sp-btn-login" id="submitBtn">
                    <span class="btn-text">Send Reset Link</span>
                </button>
            </form>

            <div class="text-center mt-4">
                <a href="/admin/login" class="text-decoration-none small" style="color: #008080;">
                    <i class="bi bi-arrow-left"></i> Back to Login
                </a>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            $("#forgotForm").on("submit", function(e) {
                const email = $("#email").val();
                if (!email || !email.includes('@')) {
                    e.preventDefault();
                    const errorHtml = `
                        <div class="sp-error-alert d-flex align-items-center gap-2 mb-0" style="background: linear-gradient(135deg, #fff5f5 0%, #ffe8e8 100%); border: 1px solid #fecaca; color: #b91c1c; border-radius: 8px; padding: 0.5rem 0.8rem; font-size: 0.8rem;">
                            <i class="bi bi-exclamation-circle-fill" style="font-size: 0.9rem;"></i>
                            <span id="errorText">Invalid Email.</span>
                        </div>
                    `;
                    $("#errorContainer").html(errorHtml);
                    $("#errorWrapper").css("max-height", "100px");
                } else {
                    $("#errorWrapper").css("max-height", "0");
                    setTimeout(() => $("#errorContainer").empty(), 400);
                    $("#submitBtn").html('<span class="spinner-border spinner-border-sm" role="status"></span>').prop("disabled", true);
                }
            });
        });
    </script>
</body>
</html>
