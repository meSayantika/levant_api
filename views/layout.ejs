<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Synergic Pay - Modern QR-Code Based Payment Administration Panel">
    <title><%= typeof title !== 'undefined' ? title : 'Synergic Pay' %></title>

    <!-- Bootstrap 5.3 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"
          integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH"
          crossorigin="anonymous">

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">

    <!-- Select2 CSS for gorgeous dropdowns -->
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css" rel="stylesheet" />

    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Custom Stylesheet -->
    <link rel="stylesheet" href="/css/style.css?v=14">
    <%- typeof style !== 'undefined' ? style : '' %>
</head>
<body>

    <div class="d-flex" id="layoutWrapper">
        <!-- Sidebar -->
        <%- include('partials/sidebar') %>

        <!-- Main Content Area -->
        <div class="flex-grow-1 d-flex flex-column" id="mainContentArea">
            <!-- Top Navbar -->
            <%- include('partials/header') %>

            <!-- Page Content -->
            <main class="flex-grow-1 p-4" id="pageContent">
                <%- body %>
            </main>

            <!-- Footer -->
            <%- include('partials/footer') %>
        </div>
    </div>

    <!-- jQuery 3.7 -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"
            integrity="sha256-/JqT3SQfawRcv/BIHPThkBvs0OEvtFFmqPF/lYI/Cxo="
            crossorigin="anonymous"></script>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
            integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz"
            crossorigin="anonymous"></script>

    <!-- Select2 JS -->
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <!-- Custom JS -->
    <script src="/js/main.js?v=6"></script>
    <%- typeof script !== 'undefined' ? script : '' %>
    <!-- Scroll Buttons -->
    <div class="scroll-buttons" style="position: fixed; bottom: 30px; right: 30px; display: flex; flex-direction: column; gap: 10px; z-index: 9999;">
        <button id="scrollToTopBtn" class="btn rounded-circle shadow" style="width: 45px; height: 45px; background: linear-gradient(135deg, #008080, #32a995); color: white; border: none; display: none; align-items: center; justify-content: center; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
            <i class="bi bi-arrow-up fs-5"></i>
        </button>
        <button id="scrollToBottomBtn" class="btn rounded-circle shadow" style="width: 45px; height: 45px; background: linear-gradient(135deg, #008080, #32a995); color: white; border: none; display: flex; align-items: center; justify-content: center; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.1)'" onmouseout="this.style.transform='scale(1)'">
            <i class="bi bi-arrow-down fs-5"></i>
        </button>
    </div>

    <script>
        $(document).ready(function() {
            // Determine scroll container (either window or #mainContentArea depending on CSS)
            var $scrollContainer = $('body').css('overflow') === 'hidden' ? $('#mainContentArea') : $(window);
            
            $scrollContainer.on('scroll', function() {
                var scrollTop = $(this).scrollTop();
                var innerHeight = $(this).innerHeight() || $(window).height();
                var scrollHeight = $(this)[0].scrollHeight || $(document).height();

                if (scrollTop > 100) {
                    $('#scrollToTopBtn').fadeIn();
                } else {
                    $('#scrollToTopBtn').fadeOut();
                }

                if (scrollTop + innerHeight >= scrollHeight - 50) {
                    $('#scrollToBottomBtn').fadeOut();
                } else {
                    $('#scrollToBottomBtn').fadeIn();
                }
            });

            $('#scrollToTopBtn').click(function() {
                $('html, body, #mainContentArea').animate({ scrollTop: 0 }, 300);
            });

            $('#scrollToBottomBtn').click(function() {
                var scrollHeight = $('#mainContentArea')[0].scrollHeight || $(document).height();
                $('html, body, #mainContentArea').animate({ scrollTop: scrollHeight }, 300);
            });
        });
    </script>
</body>
</html>
