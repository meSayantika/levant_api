<!-- =============================================
     SYNERGIC PAY - Sidebar Partial
     Modern light-themed vertical navigation
     ============================================= -->

<aside class="sp-sidebar d-flex flex-column shadow-sm" id="sidebarNav">
    <!-- Brand Logo Area -->
    <div class="sp-sidebar-brand px-4 py-3 d-flex align-items-center gap-2">
        <div class="sp-brand-icon d-flex align-items-center justify-content-center" style="background: transparent;">
            <img src="/img/logo_sss.png" alt="Logo" style="max-height: 32px; width: auto;" />
        </div>
        <div class="sp-brand-text">
            <h6 class="mb-0 fw-bold text-dark">Synergic Pay</h6>
            <small class="text-muted" style="font-size: 0.7rem; letter-spacing: 0.5px;">
                <%= (typeof user !== 'undefined' && user && user.userType === 'S') ? 'MERCHANT PANEL' : 'ADMIN PANEL' %>
            </small>
        </div>
    </div>

    <hr class="mx-3 my-0 opacity-10">

    <!-- Navigation Links -->
    <nav class="sp-sidebar-nav flex-grow-1 px-3 py-3">
        <% if (typeof menus !== 'undefined' && menus.length > 0) { %>
            <% menus.forEach(parent => { %>
                <!-- Parent Menu Header -->
                <p class="sp-nav-label text-uppercase text-muted fw-semibold mb-2 mt-3 px-2">
                    <%= parent.label || 'Menu Category' %>
                </p>

                <% if (parent.children && parent.children.length > 0) { %>
                    <% parent.children.forEach(child => { %>
                        <% const childIcon = child.icon || 'bi-circle' %>
                        <% const isActive = (typeof currentRoute !== 'undefined' && currentRoute === child.LINK) ? 'active' : '' %>
                        
                        <a href="<%= child.LINK || '#' %>" class="sp-nav-link d-flex align-items-center gap-3 px-3 py-2 rounded-3 mb-1 text-decoration-none <%= isActive %>" data-bs-toggle="tooltip" data-bs-placement="right" title="<%= child.label %>">
                            <i class="bi <%= childIcon %>"></i>
                            <span><%= child.label %></span>
                            
                            <% if (child.children && child.children.length > 0) { %>
                                <i class="bi bi-chevron-down ms-auto" style="font-size: 0.8rem;"></i>
                            <% } %>
                        </a>

                        <% if (child.children && child.children.length > 0) { %>
                            <div class="ps-4">
                                <% child.children.forEach(subChild => { %>
                                    <% const subIcon = subChild.icon || 'bi-dash' %>
                                    <a href="<%= subChild.LINK || '#' %>" class="sp-nav-link d-flex align-items-center gap-2 px-3 py-1 rounded-3 mb-1 text-decoration-none" style="font-size: 0.85rem; color: #6c757d;" data-bs-toggle="tooltip" data-bs-placement="right" title="<%= subChild.label %>">
                                        <i class="bi <%= subIcon %>" style="font-size: 0.75rem;"></i>
                                        <span><%= subChild.label %></span>
                                    </a>
                                <% }) %>
                            </div>
                        <% } %>
                    <% }) %>
                <% } %>
            <% }) %>
        <% } else { %>
            <!-- Fallback if no menus found in DB -->
            <div class="px-3 py-4 text-center text-muted">
                <i class="bi bi-exclamation-circle mb-2 fs-4"></i>
                <p class="small mb-0">No menus assigned for your user role.</p>
            </div>
        <% } %>
    </nav>

    <!-- Sidebar Footer -->
    <div class="sp-sidebar-footer px-4 py-3 border-top">
        <div class="d-flex align-items-center gap-2">
            <div class="sp-status-dot bg-success rounded-circle" style="width: 8px; height: 8px;"></div>
            <small class="text-muted">System Online</small>
        </div>
    </div>
</aside>
